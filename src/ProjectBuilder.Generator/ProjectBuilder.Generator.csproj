<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProjectBuilder.Core\ProjectBuilder.Core.csproj" />
    <PackageReference Include="Scriban" Version="7.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Angular web app template ships inside the generator and is copied into every generated system. -->
    <EmbeddedResource Include="AngularTemplate\**\*" LogicalName="AngularTemplate/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
