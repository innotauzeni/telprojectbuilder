@page "/preview/{Id:guid}"
@rendermode InteractiveServer
@using ProjectBuilder.Core
@using ProjectBuilder.Generator
@using ProjectBuilder.Studio.Services
@inject ProjectStore Store

<PageTitle>Preview</PageTitle>

@if (def is null)
{
    <p>Project not found. <a href="">Back to projects</a></p>
    return;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a href="designer/@Id" class="btn btn-sm btn-outline-secondary">← Back to designer</a>
    <h1 class="h3 m-0 me-auto">Preview: @def.Name</h1>
    @if (files is not null)
    {
        <a class="btn btn-success" href="download/@Id" download data-enhance-nav="false">Download project (.zip)</a>
    }
</div>

@if (errors.Count > 0)
{
    <div class="alert alert-warning">
        <strong>Fix these in the designer to see the preview:</strong>
        <ul class="mb-0">@foreach (var e in errors) { <li>@e</li> }</ul>
    </div>
    return;
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == "api" ? "active" : "")" @onclick='() => tab = "api"'>Try the API</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "code" ? "active" : "")" @onclick='() => tab = "code"'>Generated code (@files!.Count files)</button></li>
</ul>

@if (tab == "api")
{
    <div class="alert alert-info py-2">
        This is a <strong>live preview</strong> of the API your system will have. Use <em>Try it out</em> to add and list
        records. Data here is temporary and is not part of the download. (Needs internet to load Swagger UI.)
    </div>
    <iframe src="preview/@Id/swagger" title="API preview" style="width:100%;height:75vh;border:1px solid #ccc;border-radius:6px;background:#fff"></iframe>
}
else
{
    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="list-group" style="max-height:75vh;overflow:auto">
                @foreach (var f in files!)
                {
                    <button class="list-group-item list-group-item-action py-1 small @(f.Path == selected?.Path ? "active" : "")"
                            @onclick="() => selected = f">@f.Path</button>
                }
            </div>
        </div>
        <div class="col-md-9">
            <pre class="border rounded p-3 bg-light" style="max-height:75vh;overflow:auto"><code>@selected?.Content</code></pre>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AppDefinition? def;
    private IReadOnlyList<string> errors = [];
    private IReadOnlyList<GeneratedFile>? files;
    private GeneratedFile? selected;
    private string tab = "api";

    protected override void OnParametersSet()
    {
        def = Store.Get(Id);
        if (def is null) return;
        errors = AppDefinitionValidator.Validate(def);
        if (errors.Count == 0)
        {
            files = new ProjectGenerator().Generate(def);
            selected = files.FirstOrDefault(f => f.Path.StartsWith("Controllers/")) ?? files[0];
        }
    }
}
