{
  "schemaVersion": 1,
  "name": "Enrolment System",
  "database": "Sqlite",
  "targets": "WebApi, WebApp, Docker",
  "dynamicMenu": false,
  "accessControl": true,
  "entities": [
    {
      "name": "Student",
      "fields": [
        { "name": "FirstName", "type": "String", "required": true, "maxLength": 100 },
        { "name": "LastName", "type": "String", "required": true, "maxLength": 100 },
        { "name": "DateOfBirth", "type": "Date", "required": true },
        { "name": "Email", "type": "Email", "maxLength": 200 },
        { "name": "Phone", "type": "Phone", "maxLength": 30 },
        { "name": "StudentNumber", "type": "String", "required": true, "unique": true, "maxLength": 30 }
      ]
    },
    {
      "name": "Guardian",
      "fields": [
        { "name": "FullName", "type": "String", "required": true, "maxLength": 200 },
        { "name": "Phone", "type": "Phone", "required": true, "maxLength": 30 },
        { "name": "Email", "type": "Email", "maxLength": 200 },
        { "name": "Relationship", "type": "String", "maxLength": 50 }
      ],
      "relations": [ { "name": "Student", "targetEntity": "Student" } ]
    },
    {
      "name": "Course",
      "fields": [
        { "name": "Code", "type": "String", "required": true, "unique": true, "maxLength": 20 },
        { "name": "Title", "type": "String", "required": true, "maxLength": 200 },
        { "name": "Capacity", "type": "Int", "required": true },
        { "name": "TuitionFee", "type": "Decimal", "required": true }
      ]
    },
    {
      "name": "Term",
      "fields": [
        { "name": "Name", "type": "String", "required": true, "maxLength": 100 },
        { "name": "StartDate", "type": "Date", "required": true },
        { "name": "EndDate", "type": "Date", "required": true }
      ]
    },
    {
      "name": "Enrolment",
      "fields": [
        { "name": "EnrolledOn", "type": "Date", "required": true },
        { "name": "Status", "type": "String", "required": true, "maxLength": 30 }
      ],
      "relations": [
        { "name": "Student", "targetEntity": "Student" },
        { "name": "Course", "targetEntity": "Course" },
        { "name": "Term", "targetEntity": "Term" }
      ]
    },
    {
      "name": "Payment",
      "fields": [
        { "name": "Amount", "type": "Decimal", "required": true },
        { "name": "PaidOn", "type": "Date", "required": true },
        { "name": "Method", "type": "String", "maxLength": 50 },
        { "name": "Reference", "type": "String", "maxLength": 100 }
      ],
      "relations": [ { "name": "Enrolment", "targetEntity": "Enrolment" } ]
    }
  ]
}
